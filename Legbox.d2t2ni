def Xform "World"
{
    over "Legbox" (
        prepend references = @./Legbox/Legbox.usd@
    )
    {
        string isaac:namespace (
            displayName = "Namespace"
            doc = "Namespace of the prim in Isaac Sim"
        )
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:scale = (1, 1, 1)
        double3 xformOp:translate = (-0.005495952222688781, 0, 0.5323655830068228)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "LL1"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )

            def PhysicsRevoluteJoint "LL1" (
                prepend apiSchemas = ["PhysicsDriveAPI:physics"]
            )
            {
                custom float drive:physics:damping = 400
                custom float drive:physics:maxForce = 200
                float drive:physics:physics:damping = 5000
                float drive:physics:physics:maxForce = 5000
                float drive:physics:physics:stiffness = 100000
                float drive:physics:physics:targetPosition = 0
