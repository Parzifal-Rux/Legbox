                custom float drive:physics:stiffness = 5000
                custom float drive:physics:targetPosition = 0.1
                custom float drive:physics:targetVelocity = 0
                custom token drive:physics:type = "force"
                uniform token physics:axis = "Y"
                rel physics:body0 = </World/Legbox/BOX>
                rel physics:body1 = </World/Legbox/LL1>
                float physics:breakForce = 3.4028235e38
                float physics:breakTorque = 3.4028235e38
                point3f physics:localPos0 = (-0.15046, -0.075, 0.034413)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.49844763, 0.5015475, 0.5015458, -0.49844941)
                quatf physics:localRot1 = (1, 0, 0, 0)
                custom token physics:type = "force"
            }
        }

        over "LL3"
        {
            string isaac:nameOverride (
                displayName = "Name Override"
                doc = "Name override for prim lookup in base name search"
            )

            def PhysicsRevoluteJoint "LL3" (
                prepend apiSchemas = ["PhysicsDriveAPI:physics"]
            )
            {
                custom float drive:physics:damping = 400
                custom float drive:physics:maxForce = 200
                float drive:physics:physics:damping = 5000
                float drive:physics:physics:maxForce = 5000
                float drive:physics:physics:stiffness = 100000
                float drive:physics:physics:targetPosition = -0.5
                float drive:phys