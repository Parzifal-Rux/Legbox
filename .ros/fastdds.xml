<?xml version="1.0" encoding="UTF-8"?>
<dds>
    <profiles>
        <participant profile_name="ros2_udp" is_default_profile="true">
            <rtps>
                <!-- 禁用内置传输，强制只用UDPv4，关闭共享内存SHM -->
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>udp_transport</transport_id>
                </userTransports>
                <transport_descriptors>
                    <transport_descriptor>
                        <transport_id>udp_transport</transport_id>
                        <type>UDPv4</type>
                    </transport_descriptor>
                </transport_descriptors>
            </rtps>
        </participant>
    </profiles>
</dds>