  <!-- BUG FIX: LR2 原来质量为0、惯量全为0，会导致物理引擎奇异 -->
  <!-- 临时使用 LL2 的参数，左右对称。务必用 CAD 重新计算精确值 -->
  <link name="LR2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="meshes/LR2.STL" />
      </geometry>
