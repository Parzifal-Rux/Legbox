    </inertial>
  </link>

  <!-- 关节名全部加 _joint 后缀，避免与 link 名冲突 -->
  <!-- 轴值清理：0.000001 → 1, -0.000001 → -1 -->
  <!-- 限位按关节功能分别设置（弧度），不再是统一 0~40 -->

  <!-- 左腿髋关节 -->
  <joint name="LL1_joint" type="revolute">
    <parent link="BOX" />
    <child link="LL1" />
    <origin xyz="-0.15046 -0.075 0.034413" rpy="3.1416 1.5646 1.5708" />
    <axis xyz="0 1 0" />
    <limit lower="-0.7854" upper="0.7854" effort="91.0035" velocity="19.69" />
    <hardware>
      <brand>Unitree</brand>
      <motorType>B1-10010</motorType>
      <motorDirection>-1</motorDirection>
      <armature>0.0011969</armature>
    </hardware>
  </joint>

  <!-- 左腿膝关节 -->
  <joint name="LL3_joint" type="revolute">
    <parent link="LL1" />
    <child link="LL3" />
    <origin xyz="0.12 -0.015 0" rpy="3.1416 0.88218 0" />
    <axis xyz="0 -1 0" />
    <limit lower="-1.5708" upper="1.5708" effort="91.0035" velocity="19.69" />
    <hardware>
      <brand>Unitree</brand>
      <motorType>B1-10010</motorType>
      <motorDirection>1</motorDirection>
      <armature>0.0011969</armature>
    </hardware>
  </joint>

  <!-- 左轮：continuous，无限位 -->
  <joint name="WL_joint" type="continuous">
    <parent link="LL3" />
    <child link="WL" />
    <origin xyz="0.12 -0.055 0" rpy="3.1416 -0.64248 3.1416" />
    <axis xyz="0 1 0" />
    <hardware>
      <brand>Unitree</brand>
      <motorType>B1-10010</motorType>
      <motorDirection>1</motorDirection>
      <armature>0.0011969</armature>
    </hardware>
  </joint>

  <!-- 左腿并联杆髋端 -->
  <joint name="LL2_joint" type="revolute">
    <parent link="BOX" />
    <child link="LL2" />
    <origin xyz="-0.14546 0.075 0.034413" rpy="3.1416 1.2919 1.5708" />
